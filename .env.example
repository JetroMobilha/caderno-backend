# ==============================================================================
# CONFIGURAÇÃO GERAL DA APLICAÇÃO
# ==============================================================================
APP_NAME="Caderno Digital"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://appcaderno.duckdns.org:9000

# ==============================================================================
# BASE DE DADOS E LOGS
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caderno
DB_USERNAME=root
DB_PASSWORD= 

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# DRIVERS DE SESSÃO, CACHE E FILAS
# ==============================================================================
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ==============================================================================
# CONFIGURAÇÃO REDIS
# ==============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CONFIGURAÇÃO DE WEBSOCKETS (LARAVEL REVERB)
# ==============================================================================
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=2166657
REVERB_APP_KEY=6572db37e0db7615a423
REVERB_APP_SECRET=ff875fe33e6d727aae62

# 1. Configuração para o Frontend / Clientes (Batem na porta 6001 do Apache com SSL/WSS)
REVERB_HOST="appcaderno.duckdns.org"
REVERB_PORT=6001
REVERB_SCHEME=https

# 2. Configuração Interna (O backend do Laravel envia eventos para o Reverb internamente na porta 6002)
REVERB_SERVER_HOST="127.0.0.1"
REVERB_SERVER_PORT=6002

# Variáveis passadas automaticamente para o JavaScript/Vite no Frontend
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ==============================================================================
# SERVIÇOS EXTERNOS (EMAIL & PROXYPAY)
# ==============================================================================
#MAIL_MAILER=smtp
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=d7ea08d5ffbbd2
MAIL_PASSWORD=****5c92
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="caderno.digital@je-empredimentos.com"
MAIL_FROM_NAME="${APP_NAME}"

PROXYPAY_API_KEY="tua_chave_de_teste_gerada_no_site_da_proxypay"
PROXYPAY_ENTITY="tua_entidade"